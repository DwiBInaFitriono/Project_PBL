APP_NAME="Hidroponik DFT IoT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Aktif: Lokal (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hidroponik_dft
DB_USERNAME=root
DB_PASSWORD=

# TiDB Cloud (MySQL) — Ditutup sementara (Buka komentar '#' jika ingin mengaktifkan)
# DB_CONNECTION=mysql
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=hidroponik_dft
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=database/certs/isrgrootx1.pem

# Opsi Cadangan SQLite (Nonaktif)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite


SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# MQTT stays disabled until broker, ACL, TLS, sensor contract, and migrations
# have been reviewed and approved. Do not commit real credentials.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_CLIENT_ID=hidroponik-dft-ingestor
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TLS_CA_FILE=
MQTT_ALLOW_INSECURE_LOCAL=false

# Local Vite HMR only. Use an exact origin, no path or wildcard.
CSP_VITE_ORIGIN=
VITE_APP_NAME="${APP_NAME}"
